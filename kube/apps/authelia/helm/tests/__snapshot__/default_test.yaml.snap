renders:
  1: |
    apiVersion: v1
    data:
      configuration.yaml: |-
        storage:
          local:
            path: /data/db.sqlite3
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: authelia
        app.kubernetes.io/version: 4.39.15
      name: RELEASE-NAME-config-config
  2: |
    apiVersion: v1
    data:
      storage_encryption_key: a_very_important_secret
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: authelia
        app.kubernetes.io/version: 4.39.15
      name: RELEASE-NAME-config-secrets
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: authelia
        app.kubernetes.io/version: 4.39.15
      name: RELEASE-NAME
    spec:
      replicas: 1
      revisionHistoryLimit: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: authelia
      template:
        metadata:
          annotations:
            config-hash-config: 88c2cc876889262e70eaaadd97f676597f1aa3a5
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: authelia
        spec:
          containers:
            - env:
                - name: AUTHELIA_LOG_KEEP_STDOUT
                  value: "true"
                - name: AUTHELIA_LOG_LEVEL
                  value: info
                - name: X_AUTHELIA_CONFIG
                  value: /config/config
                - name: X_AUTHELIA_CONFIG_FILTERS
                  value: template
              image: docker.io/authelia/authelia:4.39.15
              imagePullPolicy: IfNotPresent
              name: app
              ports:
                - containerPort: 9091
                  name: app
                  protocol: TCP
              resources:
                requests:
                  cpu: 1m
                  memory: 50Mi
              volumeMounts:
                - mountPath: /config/config
                  name: config-config
                  readOnly: true
                - mountPath: /config/secrets
                  name: config-secrets
                  readOnly: true
          enableServiceLinks: false
          nodeSelector: null
          securityContext:
            fsGroup: 3000
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 3000
            runAsUser: 3000
          serviceAccountName: RELEASE-NAME
          tolerations: null
          topologySpreadConstraints:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: RELEASE-NAME
                  app.kubernetes.io/name: authelia
              maxSkew: 1
              topologyKey: topology.kubernetes.io/zone
              whenUnsatisfiable: ScheduleAnyway
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/instance: RELEASE-NAME
                  app.kubernetes.io/name: authelia
              maxSkew: 1
              topologyKey: kubernetes.io/hostname
              whenUnsatisfiable: ScheduleAnyway
          volumes:
            - configMap:
                name: RELEASE-NAME-config-config
              name: config-config
            - configMap:
                name: RELEASE-NAME-config-secrets
              name: config-secrets
  4: |
    apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: authelia
        app.kubernetes.io/version: 4.39.15
      name: RELEASE-NAME
    spec:
      minAvailable: 50%
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: authelia
  5: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: authelia
        app.kubernetes.io/version: 4.39.15
      name: RELEASE-NAME
    spec:
      ports:
        - name: app
          port: 80
          protocol: TCP
          targetPort: app
      selector:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/name: authelia
      type: ClusterIP
  6: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      annotations: null
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: authelia
        app.kubernetes.io/version: 4.39.15
      name: RELEASE-NAME
