renders a Certificate resource:
  1: |
    apiVersion: v1
    data: null
    kind: Secret
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: certmanager-issuers
        app.kubernetes.io/version: 1.0.0
      name: RELEASE-NAME-config-secrets
    type: Opaque
  2: |
    apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: my-cert
      namespace: NAMESPACE
    spec:
      commonName: example.com
      dnsNames:
        - example.com
        - '*.example.com'
      issuerRef:
        kind: Issuer
        name: letsencrypt
      secretName: my-cert
