  26: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/component: speaker
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: metallb
        app.kubernetes.io/version: v0.16.1
        helm.sh/chart: app-0.16.1
      name: RELEASE-NAME-metallb-speaker
      namespace: NAMESPACE
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/component: speaker
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: metallb
      template:
        metadata:
          labels:
            app.kubernetes.io/component: speaker
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/name: metallb
        spec:
          containers:
            - args:
                - --port=9120
                - --log-level=warn
              env:
                - name: METALLB_NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: METALLB_HOST
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
                - name: METALLB_ML_BIND_ADDR
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: METALLB_ML_LABELS
                  value: app.kubernetes.io/name=metallb,app.kubernetes.io/component=speaker
                - name: METALLB_ML_BIND_PORT
                  value: "7946"
                - name: METALLB_ML_SECRET_KEY_PATH
                  value: /etc/ml_secret_key
                - name: METALLB_BGP_TYPE
                  value: frr-k8s
                - name: METALLB_POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
              image: quay.io/metallb/speaker:v0.16.1
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  host: 127.0.0.1
                  path: /healthz
                  port: 17472
                initialDelaySeconds: 10
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 1
              name: speaker
              ports:
                - containerPort: 9120
                  name: metricshttps
                - containerPort: 7946
                  name: memberlist-tcp
                  protocol: TCP
                - containerPort: 7946
                  name: memberlist-udp
                  protocol: UDP
              readinessProbe:
                failureThreshold: 3
                httpGet:
                  host: 127.0.0.1
                  path: /readyz
                  port: 17472
                initialDelaySeconds: 10
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 1
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  add:
                    - NET_RAW
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              volumeMounts:
                - mountPath: /etc/metallb/memberlist
                  name: memberlist-config
                  readOnly: true
                - mountPath: /etc/ml_secret_key
                  name: memberlist
                - mountPath: /etc/metallb
                  name: metallb-excludel2
          hostNetwork: true
          nodeSelector:
            kubernetes.io/os: linux
          serviceAccountName: RELEASE-NAME-metallb-speaker
          terminationGracePeriodSeconds: 0
          tolerations:
            - effect: NoSchedule
              key: node-role.kubernetes.io/master
              operator: Exists
            - effect: NoSchedule
              key: node-role.kubernetes.io/control-plane
              operator: Exists
          volumes:
            - name: memberlist
              secret:
                defaultMode: 420
                secretName: RELEASE-NAME-metallb-memberlist
            - configMap:
                defaultMode: 256
                name: metallb-excludel2
              name: metallb-excludel2
            - configMap:
                name: metallb-memberlist-config
                optional: true
              name: memberlist-config
      updateStrategy:
        type: RollingUpdate
  27: |
