should render pod logs and Grafana Cloud secret:
  1: |
    raw: Thanks for trying out the alloy-operator!
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: alloy-operator
        app.kubernetes.io/version: 1.7.0
        helm.sh/chart: alloy-operator-0.5.3
      name: RELEASE-NAME-alloy-operator
      namespace: NAMESPACE
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: alloy-operator
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: alloy-operator
            app.kubernetes.io/version: 1.7.0
            helm.sh/chart: alloy-operator-0.5.3
        spec:
          containers:
            - args:
                - --health-probe-bind-address=:8081
                - --metrics-bind-address=:8082
                - --leader-elect
                - --leader-election-id=RELEASE-NAME-alloy-operator
              image: ghcr.io/grafana/alloy-operator:1.7.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: 8081
                initialDelaySeconds: 15
                periodSeconds: 20
              name: alloy-operator
              ports:
                - containerPort: 8081
                  name: http
                  protocol: TCP
                - containerPort: 8082
                  name: metrics
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 8081
                initialDelaySeconds: 5
                periodSeconds: 10
              resources:
                limits: {}
                requests: {}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
          nodeSelector:
            kubernetes.io/os: linux
          securityContext:
            runAsNonRoot: true
          serviceAccountName: RELEASE-NAME-alloy-operator
