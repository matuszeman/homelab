        name: release-name-app-remove-alloy-and-finalizer
        namespace: NAMESPACE
  22: |
    apiVersion: v1
    data:
      access_token: Z2xjX3h4eHh4eHh4eHh4eHh4eHh4eHh4
      loki_username: MTIzNDU2
    kind: Secret
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: alloy
        app.kubernetes.io/version: 1.0.0
      name: RELEASE-NAME-config-grafana-cloud
    type: Opaque
